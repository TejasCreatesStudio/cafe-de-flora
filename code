    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        flora: {
                            bg: '#FAF6F0',
                            card: '#F4EBE1',
                            burgundy: '#6B1D2F',
                            burgundyDark: '#4A121F',
                            gold: '#D4AF37',
                            goldDark: '#AA8828',
                            green: '#2C4A3E',
                            dark: '#221C1B',
