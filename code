    <style>
        body {
            background-color: #FAF6F0;
            color: #221C1B;
            font-family: 'Montserrat', sans-serif;
            background-image: radial-gradient(#D4AF37 0.4px, transparent 0.4px), radial-gradient(#6B1D2F 0.4px, #FAF6F0 0.4px);
            background-size: 32px 32px;
            background-position: 0 0, 16px 16px;
            background-opacity: 0.05;
        }

        .gold-border-frame {
            border: 2px solid #D4AF37;
            position: relative;
        }
        .gold-border-frame::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            right: 3px;
            bottom: 3px;
            border: 1px solid rgba(212, 175, 55, 0.4);
            pointer-events: none;
        }

        .menu-card {
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }
        .menu-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(107, 29, 47, 0.12);
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #F4EBE1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #6B1D2F;
            border-radius: 4px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-flora-burgundy selection:text-flora-gold">

