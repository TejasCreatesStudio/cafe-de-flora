            </button>
        </div>

        <!-- Gallery Grid -->
        <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Dynamic Customer Photos inserted via JS -->
        </div>
    </section>

    <section id="about" class="py-12 px-4 max-w-7xl mx-auto w-full">
        <div class="bg-flora-card rounded-2xl p-8 lg:p-12 gold-border-frame grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
            <div class="lg:col-span-2">
                <span class="text-xs uppercase tracking-widest text-flora-goldDark font-semibold block mb-2">Visit Us</span>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-flora-burgundy mb-4">Cafe De Flora Experience</h2>
                <p class="text-flora-textMuted text-sm leading-relaxed mb-6">
                    A botanical escape designed to indulge all senses. From wood-fired Neapolitan pizzas crafted with authentic Italian flour to exquisite hand-crafted appetizers and specialty coffees.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-flora-dark mb-6">
                    <div class="flex items-start space-x-3 bg-flora-bg p-3.5 rounded-xl border border-flora-gold/30">
                        <i class="fa-solid fa-clock text-flora-burgundy text-lg mt-0.5"></i>
                        <div>
                            <strong class="block text-flora-burgundy">Opening Hours</strong>
                            <span>Mon - Sun: 11:00 AM – 11:00 PM</span>
                        </div>
                    </div>
                    <div class="flex items-start space-x-3 bg-flora-bg p-3.5 rounded-xl border border-flora-gold/30">
                        <i class="fa-solid fa-location-dot text-flora-burgundy text-lg mt-0.5"></i>
                        <div>
                            <strong class="block text-flora-burgundy">Location & Address</strong>
                            <span>Cafe De Flora, Botanical District</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-flora-burgundy text-flora-bg p-6 rounded-xl text-center space-y-4 border border-flora-gold">
                <i class="fa-solid fa-utensils text-3xl text-flora-gold"></i>
                <h3 class="font-serif text-2xl font-bold">Planning a Gathering?</h3>
                <p class="text-xs text-flora-bg/80">Reserve a table in our outdoor garden gazebo or private indoor floral dining room.</p>
                <button onclick="openBookingModal()" class="w-full bg-flora-gold hover:bg-flora-goldDark text-flora-dark font-bold py-3 rounded-full text-xs uppercase tracking-widest transition-all">
                    Book Table Now
                </button>
            </div>
        </div>
    </section>

    <footer class="mt-auto border-t border-flora-gold/30 bg-flora-card py-8 text-center text-xs text-flora-textMuted">
        <div class="max-w-7xl mx-auto px-4 space-y-3">
            <p class="font-serif text-lg font-bold text-flora-burgundy">CAFE DE FLORA</p>
            <p>&copy; 2026 Cafe De Flora. All Rights Reserved. Crafted with Italian Passion.</p>
        </div>
    </footer>

    <div id="bookingModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-flora-bg w-full max-w-md rounded-2xl gold-border-frame p-6 sm:p-8 relative animate-fade-in shadow-2xl">
            <button onclick="closeBookingModal()" class="absolute top-4 right-4 text-flora-textMuted hover:text-flora-burgundy text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="text-center mb-6">
                <h3 class="font-serif text-2xl font-bold text-flora-burgundy">Reserve a Table</h3>
                <p class="text-xs text-flora-textMuted">Join us at Cafe De Flora for a dining experience.</p>
            </div>
            <form onsubmit="handleBookingSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Full Name</label>
                    <input type="text" required placeholder="John Doe" class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Guests</label>
                        <select class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy">
                            <option>2 People</option>
                            <option>3 People</option>
                            <option>4 People</option>
                            <option>5+ People</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Time</label>
                        <input type="time" value="19:00" required class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Special Request</label>
                    <textarea rows="2" placeholder="Birthday, anniversary, garden seating..." class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy"></textarea>
                </div>
                <button type="submit" class="w-full bg-flora-burgundy text-flora-gold py-3 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-flora-burgundyDark transition-all shadow">
                    Confirm Reservation
                </button>
            </form>
        </div>
    </div>

    <div id="uploadModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-flora-bg w-full max-w-md rounded-2xl gold-border-frame p-6 sm:p-8 relative animate-fade-in shadow-2xl">
            <button onclick="closeUploadModal()" class="absolute top-4 right-4 text-flora-textMuted hover:text-flora-burgundy text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="text-center mb-6">
                <h3 class="font-serif text-2xl font-bold text-flora-burgundy">Share Your Dish Photo</h3>
                <p class="text-xs text-flora-textMuted">Upload your photograph to be featured in our guest gallery!</p>
            </div>
            <form onsubmit="handlePhotoUpload(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Dish Name</label>
                    <input type="text" id="uploadDishName" required placeholder="e.g. Chicken Fiesta Pizza" class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Image URL or Preset</label>
                    <input type="url" id="uploadImageUrl" required placeholder="https://..." class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-flora-burgundy mb-1">Your Name / Handle</label>
                    <input type="text" id="uploadCustomerName" required placeholder="@foodie_explorer" class="w-full px-3 py-2 text-xs bg-flora-card border border-flora-gold/40 rounded-lg focus:outline-none focus:border-flora-burgundy">
                </div>
                <button type="submit" class="w-full bg-flora-burgundy text-flora-gold py-3 rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-flora-burgundyDark transition-all shadow">
                    Submit Photo
                </button>
            </form>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-6 right-6 bg-flora-burgundy text-flora-gold border border-flora-gold px-5 py-3 rounded-xl shadow-2xl z-50 text-xs font-medium hidden transition-all duration-300">
        <span id="toastMsg">Action completed successfully!</span>
    </div>

