        ];

        let activeCategory = 'all';

        window.onload = function() {
            renderCategoryTabs();
            renderMenuItems();
            renderGallery();
        };

        function renderCategoryTabs() {
            const categories = [
                { id: 'all', label: 'All Items' },
                { id: 'pizza', label: 'Pizza Neapolitan' },
                { id: 'small-plates', label: 'Small Plates' },
                { id: 'beverages', label: 'Beverages' },
                { id: 'desserts', label: 'Desserts' }
            ];

            const tabsContainer = document.getElementById('categoryTabs');
            tabsContainer.innerHTML = categories.map(cat => `
                <button onclick="setCategory('${cat.id}')" class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
                    activeCategory === cat.id 
                    ? 'bg-flora-burgundy text-flora-gold shadow' 
                    : 'bg-flora-bg text-flora-textMuted hover:text-flora-burgundy border border-flora-gold/20'
                }">
                    ${cat.label}
                </button>
            `).join('');
        }

        function setCategory(catId) {
            activeCategory = catId;
            renderCategoryTabs();
            renderMenuItems();
        }

        function renderMenuItems() {
            const grid = document.getElementById('menuGrid');
            const searchVal = document.getElementById('searchInput').value.toLowerCase();
            const dietaryVal = document.getElementById('dietaryFilter').value;

            const filtered = menuData.filter(item => {
                const matchesCategory = activeCategory === 'all' || item.category === activeCategory;
                const matchesSearch = item.title.toLowerCase().includes(searchVal) || item.description.toLowerCase().includes(searchVal);
                let matchesDietary = true;

                if (dietaryVal === 'veg') matchesDietary = item.isVeg;
                if (dietaryVal === 'chef') matchesDietary = item.isChef;

                return matchesCategory && matchesSearch && matchesDietary;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-12 text-flora-textMuted">
                        <i class="fa-solid fa-utensils text-3xl mb-2 block text-flora-gold"></i>
                        <p>No culinary items match your filter criteria.</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(item => `
                <div class="bg-flora-card rounded-2xl overflow-hidden gold-border-frame menu-card flex flex-col justify-between">
                    <div>
                        <div class="relative h-48 overflow-hidden">
                            <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" onerror="this.src='https://placehold.co/600x400/6B1D2F/D4AF37?text=Cafe+De+Flora'">
                            <div class="absolute top-3 right-3 bg-flora-burgundy text-flora-gold font-bold px-3 py-1 rounded-full text-xs shadow-md border border-flora-gold/40">
                                ${item.price}
                            </div>
                            ${item.isVeg ? '<span class="absolute top-3 left-3 bg-green-800 text-white text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded shadow">Veg</span>' : ''}
                        </div>
                        <div class="p-5">
                            <div class="flex items-center justify-between mb-1">
                                <h3 class="font-serif text-xl font-bold text-flora-burgundy">${item.title}</h3>
                                ${item.isChef ? '<span class="text-xs text-flora-goldDark font-semibold" title="Chef Recommendation"><i class="fa-solid fa-star"></i> Chef\'s Special</span>' : ''}
                            </div>
                            <p class="text-flora-textMuted text-xs leading-relaxed mt-2">${item.description}</p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-2">
                        <button onclick="showToast('Added ${item.title.replace(/'/g, "\\'")} to your interest list!')" class="w-full bg-flora-bg hover:bg-flora-burgundy hover:text-flora-gold border border-flora-burgundy text-flora-burgundy py-2 rounded-lg text-xs uppercase tracking-wider font-semibold transition-all flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-plus text-[10px]"></i>
                            <span>Inquire Dish</span>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function filterMenuItems() {
            renderMenuItems();
        }

        function renderGallery() {
            const galleryGrid = document.getElementById('galleryGrid');
            galleryGrid.innerHTML = customerGallery.map(item => `
                <div class="bg-flora-card rounded-xl overflow-hidden gold-border-frame shadow-md group relative">
                    <div class="h-56 overflow-hidden relative">
                        <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='https://placehold.co/600x400/6B1D2F/D4AF37?text=Guest+Photo'">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-80"></div>
                        <div class="absolute bottom-3 left-3 right-3 text-white">
                            <h4 class="font-serif text-base font-bold leading-tight">${item.title}</h4>
                            <span class="text-[11px] text-flora-gold block mt-0.5">Shared by ${item.customer}</span>
                        </div>
                    </div>
                    <div class="p-3 bg-flora-bg flex items-center justify-between border-t border-flora-gold/20">
                        <span class="text-xs text-flora-textMuted"><i class="fa-solid fa-heart text-flora-burgundy mr-1"></i> ${item.likes} Likes</span>
                        <button onclick="likePhoto(${item.id})" class="text-xs bg-flora-card hover:bg-flora-burgundy hover:text-flora-gold border border-flora-gold/40 text-flora-burgundy px-3 py-1 rounded-full transition-all">
                            <i class="fa-regular fa-thumbs-up"></i> Like
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function likePhoto(id) {
            const photo = customerGallery.find(p => p.id === id);
            if(photo) {
                photo.likes += 1;
                renderGallery();
                showToast(`Liked photo by ${photo.customer}!`);
            }
        }

        // Modal Controls & Handlers
        function openBookingModal() {
            document.getElementById('bookingModal').classList.remove('hidden');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function handleBookingSubmit(e) {
            e.preventDefault();
            closeBookingModal();
            showToast('Table reservation request submitted successfully! We will confirm shortly.');
        }

        function openUploadModal() {
            document.getElementById('uploadModal').classList.remove('hidden');
        }

        function closeUploadModal() {
            document.getElementById('uploadModal').classList.add('hidden');
        }

        function handlePhotoUpload(e) {
            e.preventDefault();
            const title = document.getElementById('uploadDishName').value;
            const url = document.getElementById('uploadImageUrl').value;
            const customer = document.getElementById('uploadCustomerName').value;

            customerGallery.unshift({
                id: Date.now(),
                title: title,
                customer: customer.startsWith('@') ? customer : `@${customer}`,
                likes: 1,
                image: url
            });

            closeUploadModal();
            renderGallery();
            showToast('Your dish photo has been added to our guest showcase!');
            e.target.reset();
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toastMsg');
            msg.textContent = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>
