                <div class="w-10 h-10 rounded-full border-2 border-flora-gold bg-flora-burgundy flex items-center justify-center shadow-md">
                    <i class="fa-solid font-serif text-flora-gold text-xl italic">F</i>
                </div>
                <div>
                    <span class="font-serif text-2xl font-bold tracking-wider text-flora-burgundy block leading-tight">CAFE DE FLORA</span>
                    <span class="text-[10px] tracking-widest text-flora-goldDark uppercase block">Botanical Bistro & Pizzeria</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-8 text-xs uppercase tracking-widest font-semibold text-flora-dark">
                <a href="#menu" class="hover:text-flora-burgundy transition-colors">Menu</a>
                <a href="#gallery" class="hover:text-flora-burgundy transition-colors">Customer Dish Highlights</a>
                <a href="#about" class="hover:text-flora-burgundy transition-colors">About & Location</a>
            </nav>

            <button onclick="openBookingModal()" class="bg-flora-burgundy hover:bg-flora-burgundyDark text-flora-gold border border-flora-gold px-5 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold shadow-md transition-all transform hover:scale-105 flex items-center space-x-2">
                <i class="fa-regular fa-calendar-check"></i>
                <span>Reserve Table</span>
            </button>
        </div>
    </header>

    <section id="hero" class="relative py-12 md:py-20 px-4 max-w-7xl mx-auto w-full">
        <div class="bg-flora-card rounded-2xl p-8 md:p-14 gold-border-frame shadow-xl overflow-hidden relative">
            <!-- Decorative Corner Botanical SVGs -->
            <div class="absolute top-0 left-0 w-24 h-24 opacity-20 pointer-events-none text-flora-burgundy">
